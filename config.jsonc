{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
    "type": "auto",
    "source": "/etc/sword-branding/logo.png",
    "width": 23,
    "height": 10,
    "padding": {
      "top": 1,
      "left": 1,
      "right": 0
    }
    },
    "display": {
        "color": "magenta",
        "constants":[
            "    "// {$1}, used in Custom module
        ],
        "key": {
            "paddingLeft": 1
        }
        },

    "modules": [
    "break",
    "break",
        {
  "type": "command",
  "key": "S",
  "text": "bash ~/.config/fastfetch/software.sh"
        },
        {
  "type": "command",
  "key": "H",
  "text": "bash ~/.config/fastfetch/hardware.sh"
        },
        {
  "type": "command",
  "key": "M",
  "text": "bash ~/.config/fastfetch/memory.sh"
        },
        {
  "type": "command",
  "key": "T",
  "text": "bash ~/.config/fastfetch/time.sh"
        },
        {
            "type": "colors",
            "paddingLeft": 2,
            "symbol": "circle"
        }
    ]
}

